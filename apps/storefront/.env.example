# Where the Go API lives. Leave empty to run on the bundled demo data without a backend.
# Development: /api (the dev server proxies it to http://localhost:8787) · Production (same host): /api
VITE_API_URL=
# The parent domain of store hosts: http://lari.localhost:5375 opens the lari store. Development uses
# localhost:5375 when this is unset; a production build without it serves stores under /{store}.
VITE_STORE_ROOT_DOMAIN=localhost:5375
# Admin origins allowed to send preview state to an embedded store.
VITE_ADMIN_ORIGINS=http://localhost:5373,http://localhost:4373
