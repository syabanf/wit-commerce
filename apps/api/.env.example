DATABASE_URL=postgres://commerce:commerce@localhost:5433/commerce?sslmode=disable
# The Go tests empty and reseed this database on every run; keep it apart from the one above.
TEST_DATABASE_URL=postgres://commerce:commerce@localhost:5433/commerce_test?sslmode=disable
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
# Every seeded user signs in with this password while DEMO_LOGIN is on.
DEMO_PASSWORD=commerce-demo
# Encrypts connector secrets: openssl rand -base64 32. Required when DEMO_LOGIN=false; losing it loses the stored values.
CREDENTIALS_KEY=
# Off in production: staff sign in with a password, and shoppers register. Create the first admin with
# ADMIN_EMAIL=... ADMIN_PASSWORD=... api -set-admin
DEMO_LOGIN=true
# Local development uses 8787 (apps/*/.env.api); the Docker image listens on 8090.
PORT=8787
# Lets webhooks call http:// and internal addresses. Development only.
WEBHOOK_ALLOW_INTERNAL=true
# Comma-separated origins allowed to call the API from another host; empty for same-origin.
ALLOWED_ORIGINS=http://localhost:5373,http://localhost:5374,http://localhost:5375
# Where the demo seed JSON lives; defaults to ../../packages/fixtures/data.
SEED_DIR=
# The shopper chat's model, on Ollama. Leave the key empty to run on the built-in parser. Never commit it.
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash
# Set behind a reverse proxy, so the per-shopper limit reads X-Forwarded-For.
TRUST_PROXY=false
# Password and confirmation emails through Resend. A platform admin can instead save the key and sender
# under Settings → Email, and those win over these two. With neither, those flows are off. Never commit it.
RESEND_API_KEY=
# The sender, on a domain verified in Resend.
EMAIL_FROM=Commerce OS <noreply@example.com>
# The site's address, for links in email.
PUBLIC_URL=http://localhost:5373
