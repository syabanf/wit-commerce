# With certificates mounted, plain http only answers the health check and redirects to https.
server {
  listen 80 default_server;
  server_name _;
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
  location / {
    return 301 https://$host$request_uri;
  }
}
