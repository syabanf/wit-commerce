# Rendered at container start by the official nginx entrypoint. 18-commerce.envsh sets the COMMERCE_*
# values from STORE_ROOT_DOMAIN, SPLIT_SERVICES and the mounted certificates.

# Behind Cloudflare the shopper's address is CF-Connecting-IP; the API's per-shopper limit reads it.
map $http_cf_connecting_ip $shopper_ip {
  default $http_cf_connecting_ip;
  ""      $remote_addr;
}

# The scheme the shopper used: the proxy in front says so, otherwise it is this server's own.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

# Docker's DNS. Upstreams are looked up again every 10 seconds, so a recreated api container is found.
resolver 127.0.0.11 valid=10s ipv6=off;

server_tokens off;
# Redirects keep the host and port the browser used, which matters behind a published port.
absolute_redirect off;

gzip on;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml;

${COMMERCE_TLS_REDIRECT}

# The main host: the admin at /, the storefront under /shop/ (or a redirect to the store hosts) and
# the seller app under /seller/.
server {
  listen ${COMMERCE_LISTEN} default_server;
  server_name _;
  ${COMMERCE_TLS}
  root /srv/web/main;

  include /etc/nginx/conf.d/commerce/backend.inc;
  ${COMMERCE_SHOP}

  location = /seller {
    return 301 /seller/;
  }
  location /seller/ {
    include /etc/nginx/conf.d/commerce/no-cache.inc;
    try_files $uri /seller/index.html;
    location ^~ /seller/assets/ {
      include /etc/nginx/conf.d/commerce/immutable.inc;
    }
    location = /seller/manifest.webmanifest {
      include /etc/nginx/conf.d/commerce/no-cache.inc;
      default_type application/manifest+json;
    }
  }

  location ^~ /assets/ {
    include /etc/nginx/conf.d/commerce/immutable.inc;
  }
  location / {
    include /etc/nginx/conf.d/commerce/no-cache.inc;
    try_files $uri /index.html;
  }
}

${COMMERCE_STORES}
