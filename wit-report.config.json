{
  "product": "Commerce OS",
  "client": "Belum ditentukan",
  "style": "wit-code-agent",
  "base": null,
  "checks": [
    {
      "name": "Pemeriksaan tipe",
      "cmd": "pnpm typecheck"
    },
    {
      "name": "Lint",
      "cmd": "pnpm lint"
    },
    {
      "name": "Tes",
      "cmd": "pnpm test"
    },
    {
      "name": "Build",
      "cmd": "pnpm build"
    }
  ],
  "themes": [
    "light"
  ],
  "apps": {
    "admin": {
      "devices": [
        "desktop",
        "tablet",
        "phone"
      ],
      "dist": "apps/admin/dist",
      "baseUrl": "http://localhost:4373",
      "start": "pnpm --filter @rc/admin preview --port 4373 --strictPort",
      "localStorage": {
        "rc.admin.session": {
          "userId": "usr-andi",
          "tenantId": "ten-lari"
        }
      }
    },
    "mobile": {
      "devices": [
        "phone"
      ],
      "dist": "apps/mobile/dist",
      "baseUrl": "http://localhost:4374",
      "start": "pnpm --filter @rc/mobile preview --port 4374 --strictPort",
      "localStorage": {
        "rc.mobile.session": {
          "userId": "usr-fahmi",
          "tenantId": "ten-lari",
          "sellerId": "sel-fahmi"
        }
      }
    },
    "storefront": {
      "devices": [
        "desktop",
        "tablet",
        "phone"
      ],
      "dist": "apps/storefront/dist",
      "baseUrl": "http://localhost:4375",
      "start": "pnpm --filter @rc/storefront preview --port 4375 --strictPort",
      "localStorage": {}
    }
  },
