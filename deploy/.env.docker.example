# Runs the whole product on a laptop with Docker alone:
#
#   cp deploy/.env.docker.example deploy/.env.docker
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env.docker up --build
#
# Then open http://localhost:8080 (admin), http://localhost:8080/shop/lari (a store) and
# http://localhost:8080/seller/ (the seller app). Stop with `down`, and add -v to delete the data.
#
# Every value here is a dummy for local use. On a server, scripts/deploy-prod.sh generates real
# secrets into .env.production instead; never commit that file.

# Secrets. Any long random string works locally; on a server use `openssl rand -hex 32`.
POSTGRES_PASSWORD=local-postgres-password
JWT_SECRET=local-jwt-secret-change-me-0123456789abcdef
# 32 bytes, base64 (openssl rand -base64 32). It encrypts the connector secrets saved in the admin.
CREDENTIALS_KEY=bG9jYWwtY3JlZGVudGlhbHMta2V5LTMyLWJ5dGVzISE=
# The password every demo account signs in with.
DEMO_PASSWORD=local-demo-password
# true opens the demo accounts to everyone and ships the password in the JavaScript, so the login page's
# demo buttons work. Keep VITE_DEMO_PASSWORD equal to DEMO_PASSWORD when true, and empty when false.
DEMO_LOGIN=true
VITE_DEMO_PASSWORD=local-demo-password

# The AI shopper chat. A dummy key starts the stack; the chat answers with an error until it is real.
OLLAMA_API_KEY=not-set
# Email for password resets; empty turns email off.
RESEND_API_KEY=
EMAIL_FROM=

# The address people open. The admin links to stores from it and the storefront accepts the admin's
# visual editor from it, so it must match WEB_PORT.
PUBLIC_URL=http://localhost:8080
# Empty: every store lives at PUBLIC_URL/shop/{store}. Set it to give each store its own host, for
# example localhost:8080 for http://lari.localhost:8080 (browsers resolve *.localhost to this machine).
STORE_ROOT_DOMAIN=

# Where web listens. Use 0.0.0.0 to reach it from other devices on the network.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Used only when certificates sit in WEB_CERTS (fullchain.pem and privkey.pem).
WEB_TLS_PORT=8443
WEB_CERTS=./deploy/certs

# Uploaded images. "media" is a Docker volume; on a server it is a host folder such as
# /var/lib/commerce/media.
MEDIA_ROOT=media

# Ports on 127.0.0.1 for the API and, with SPLIT_SERVICES=true, the AI and shop services.
API_PORT=8090
AI_PORT=8091
SHOP_PORT=8093
# true runs the AI chat, the storefront reads and the email worker as their own containers; set
# COMPOSE_PROFILES=split with it so Compose starts them.
SPLIT_SERVICES=false
COMPOSE_PROFILES=
